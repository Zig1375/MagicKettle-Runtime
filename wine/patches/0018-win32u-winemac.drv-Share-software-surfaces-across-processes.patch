+void flush_shared_window_surface(HWND hwnd, UINT id)
+{
+    struct window_surface *surface = NULL;
+    WND *win = get_win_ptr(hwnd);
+
+    if (!win || win == WND_OTHER_PROCESS || win == WND_DESKTOP) return;
+    TRACE("shared GDI notify hwnd %p id %u surface %p current id %u\n", hwnd, id, win->surface,
+          win->surface && win->surface->shared ? win->surface->shared->id : 0);
+    if (win->surface && win->surface->shared && win->surface->shared->id == id)
+        window_surface_add_ref((surface = win->surface));
+    release_win_ptr(win);
+    if (!surface) return;
+    window_surface_flush(surface);
+    window_surface_release(surface);
 }

