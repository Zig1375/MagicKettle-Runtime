+
+/* An opt-in software surface transport. The owner keeps the native window; other processes map only
+ * its pixels. The NT mutant is recursive and shared by all opted-in window surfaces, so a cross-surface
+ * blit cannot acquire the backing locks in a different order in another process. Native presentation
+ * remains on the owning thread and is requested asynchronously, never while waiting on another UI thread.
+ */
+#define SHARED_SURFACE_OFFSET 0x10000
+#define SHARED_SURFACE_MAGIC 0x47444953
+struct shared_window_surface
+{
+    UINT magic, id;
+    LONG valid;
+    RECT rect, dirty;
+    BITMAPINFOHEADER info;
+};
+
+static pthread_once_t shared_surface_once = PTHREAD_ONCE_INIT;
+static HANDLE shared_surface_mutex;
+static LONG shared_surface_serial;
+static const WCHAR shared_surface_prop[] = u"__wine_shared_gdi_surface";
+
+static void init_shared_surface_mutex(void)
+{
+    WCHAR nameW[128];
+    UNICODE_STRING name = {.Buffer = nameW};
+    OBJECT_ATTRIBUTES attr;
+    char buffer[128];
+    const char *enabled = getenv("WINE_CROSS_PROCESS_GDI");
+
+    TRACE("cross-process GDI opt-in %s\n", debugstr_a(enabled));
+
+    if (!enabled || !atoi(enabled)) return;
+    snprintf(buffer, sizeof(buffer), "\\Sessions\\%u\\BaseNamedObjects\\shared_gdi_lock",
+             RtlGetCurrentPeb()->SessionId);
+    name.MaximumLength = asciiz_to_unicode(nameW, buffer);
+    name.Length = name.MaximumLength - sizeof(WCHAR);
+    InitializeObjectAttributes(&attr, &name, OBJ_OPENIF, NULL, NULL);
+    if (NtCreateMutant(&shared_surface_mutex, MUTEX_ALL_ACCESS, &attr, FALSE) < 0) shared_surface_mutex = 0;
+    TRACE("shared GDI mutex %p\n", shared_surface_mutex);
+}
+
+static void shared_surface_name(UNICODE_STRING *name, WCHAR *bufferW, HWND hwnd, DWORD pid, UINT id)
+{
+    char buffer[160];
+    snprintf(buffer, sizeof(buffer), "\\Sessions\\%u\\BaseNamedObjects\\gdi_%08x_%08x_%08x",
+             RtlGetCurrentPeb()->SessionId, pid, HandleToUlong(hwnd), id);
+    name->Buffer = bufferW;
+    name->MaximumLength = asciiz_to_unicode(bufferW, buffer);
+    name->Length = name->MaximumLength - sizeof(WCHAR);
+}
+
+static HBITMAP create_shared_surface_bitmap(struct window_surface *surface, BITMAPINFO *info)
+{
+    WCHAR nameW[160];
+    UNICODE_STRING name;
+    OBJECT_ATTRIBUTES attr;
+    LARGE_INTEGER size;
+    SIZE_T view_size = SHARED_SURFACE_OFFSET;
+    HANDLE section;
+    HBITMAP bitmap;
+    void *mapping = NULL;
+    UINT id;
+
+    pthread_once(&shared_surface_once, init_shared_surface_mutex);
+    if (!shared_surface_mutex || !surface->hwnd || info->bmiHeader.biBitCount != 32 ||
+        info->bmiHeader.biCompression != BI_RGB || !info->bmiHeader.biSizeImage ||
+        info->bmiHeader.biSizeImage > 256 * 1024 * 1024) return 0;
+
+    id = InterlockedIncrement(&shared_surface_serial);
+    shared_surface_name(&name, nameW, surface->hwnd, GetCurrentProcessId(), id);
+    InitializeObjectAttributes(&attr, &name, 0, NULL, NULL);
+    size.QuadPart = SHARED_SURFACE_OFFSET + (ULONGLONG)info->bmiHeader.biSizeImage;
+    if (NtCreateSection(&section, SECTION_ALL_ACCESS, &attr, &size, PAGE_READWRITE, SEC_COMMIT, NULL)) return 0;
+    if (NtMapViewOfSection(section, NtCurrentProcess(), &mapping, 0, 0, NULL, &view_size,
+                           ViewUnmap, 0, PAGE_READWRITE))
+    {
+        NtClose(section);
+        return 0;
+    }
+    bitmap = NtGdiCreateDIBSection(0, section, SHARED_SURFACE_OFFSET, info, DIB_RGB_COLORS, 0, 0, 0, NULL);
+    if (!bitmap)
+    {
+        NtUnmapViewOfSection(NtCurrentProcess(), mapping);
+        NtClose(section);
+        return 0;
+    }
+    surface->shared = mapping;
+    surface->shared_section = section;
+    surface->shared->magic = SHARED_SURFACE_MAGIC;
+    surface->shared->id = id;
+    surface->shared->valid = TRUE;
+    surface->shared->rect = surface->rect;
+    surface->shared->info = info->bmiHeader;
+    TRACE("shared GDI backing hwnd %p id %u bitmap %p\n", surface->hwnd, id, bitmap);
+    reset_bounds(&surface->shared->dirty);
+    return bitmap;
+}
+
+static void foreign_surface_set_clip(struct window_surface *surface, const RECT *rects, UINT count) {}
+
+static BOOL foreign_surface_flush(struct window_surface *surface, const RECT *rect, const RECT *dirty,
+                                  const BITMAPINFO *info, const void *bits, BOOL shape_changed,
+                                  const BITMAPINFO *shape_info, const void *shape_bits)
+{
+    if (!surface->shared->valid) return TRUE;
+    TRACE("foreign GDI flush hwnd %p id %u dirty %s\n", surface->hwnd, surface->shared->id,
+          wine_dbgstr_rect(dirty));
+    add_bounds_rect(&surface->shared->dirty, dirty);
+    NtUserMessageCall(surface->hwnd, WM_WINE_FLUSH_SHARED_SURFACE, surface->shared->id, 0,
+                      0, NtUserSendNotifyMessage, FALSE);
+    return TRUE;
+}
+
+static void foreign_surface_destroy(struct window_surface *surface) {}
+
+static const struct window_surface_funcs foreign_surface_funcs =
+{
+    .size = sizeof(struct window_surface),
+    .set_clip = foreign_surface_set_clip,
+    .flush = foreign_surface_flush,
+    .destroy = foreign_surface_destroy
+};
+
+static struct window_surface *open_foreign_window_surface(HWND hwnd)
+{
+    struct shared_window_surface *shared;
+    struct window_surface *surface = NULL;
+    SECTION_BASIC_INFORMATION section_info;
+    WCHAR nameW[160];
+    UNICODE_STRING name;
+    OBJECT_ATTRIBUTES attr;
+    SIZE_T view_size = SHARED_SURFACE_OFFSET;
+    DWORD pid;
+    HANDLE section;
+    BITMAPINFO info = {0};
+    HBITMAP bitmap;
+    void *mapping = NULL;
+    UINT id;
+
+    pthread_once(&shared_surface_once, init_shared_surface_mutex);
+    id = HandleToUlong(NtUserGetProp(hwnd, shared_surface_prop));
+    TRACE("foreign GDI hwnd %p id %u mutex %p\n", hwnd, id, shared_surface_mutex);
+    if (!shared_surface_mutex || !id) return NULL;
+    get_window_thread(hwnd, &pid);
+    shared_surface_name(&name, nameW, hwnd, pid, id);
+    InitializeObjectAttributes(&attr, &name, 0, NULL, NULL);
+    if (NtOpenSection(&section, SECTION_ALL_ACCESS, &attr)) return NULL;
+    if (NtQuerySection(section, SectionBasicInformation, &section_info, sizeof(section_info), NULL) ||
+        section_info.Size.QuadPart < SHARED_SURFACE_OFFSET) goto done;
+    if (NtMapViewOfSection(section, NtCurrentProcess(), &mapping, 0, 0, NULL, &view_size,
+                           ViewUnmap, 0, PAGE_READWRITE)) goto done;
+    shared = mapping;
+    NtWaitForSingleObject(shared_surface_mutex, FALSE, NULL);
+    if (shared->magic != SHARED_SURFACE_MAGIC || shared->id != id || !shared->valid ||
+        shared->info.biBitCount != 32 || shared->info.biCompression != BI_RGB ||
+        shared->info.biWidth <= 0 || shared->info.biHeight >= 0 ||
+        shared->info.biSizeImage != (ULONGLONG)shared->info.biWidth * -(LONGLONG)shared->info.biHeight * 4 ||
+        (ULONGLONG)shared->info.biSizeImage + SHARED_SURFACE_OFFSET > section_info.Size.QuadPart)
+        goto unlock;
+    info.bmiHeader = shared->info;
+    bitmap = NtGdiCreateDIBSection(0, section, SHARED_SURFACE_OFFSET, &info, DIB_RGB_COLORS, 0, 0, 0, NULL);
+    if (!bitmap) goto unlock;
+    surface = window_surface_create(&foreign_surface_funcs, hwnd, &shared->rect, &info, bitmap);
+    if (!surface) NtGdiDeleteObjectApp(bitmap);
+    else
+    {
+        surface->shared = shared;
+        surface->shared_section = section;
+        surface->foreign = TRUE;
+        mapping = NULL;
+        section = 0;
+    }
+unlock:
+    NtReleaseMutant(shared_surface_mutex, NULL);
+done:
+    if (mapping) NtUnmapViewOfSection(NtCurrentProcess(), mapping);
+    if (section) NtClose(section);
+    return surface;
 }

